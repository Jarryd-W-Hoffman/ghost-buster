{
    "name": "jarryd/ghost-buster",
    "description": "Identify and haunt down unused routes in your laravel application.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jarryd Hoffman",
            "email": "jarryd.hoffman@windowslive.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Jarryd\\GhostBuster\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jarryd\\GhostBuster\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jarryd\\GhostBuster\\GhostBusterServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
